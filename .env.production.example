# =============================================================================
# HR Platform - Production Environment Template
#
# Instructions:
#   1. Copy this file to .env.production:
#        cp .env.production.example .env.production
#   2. Replace all placeholder values with cryptographically secure credentials.
#   3. Never commit .env.production to version control.
#
# Deployment:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL 16 (Row-Level Security Architecture)
# -----------------------------------------------------------------------------
# Database name
POSTGRES_DB=hr

# Schema owner role (owns schema, runs Flyway migrations)
POSTGRES_USER=hr_owner
POSTGRES_PASSWORD=replace-with-strong-db-owner-password-min-16-chars

# Application runtime role (DML only, enforces PostgreSQL Row-Level Security)
POSTGRES_APP_USER=hr_app_login
POSTGRES_APP_PASSWORD=replace-with-strong-app-login-password-min-16-chars

# -----------------------------------------------------------------------------
# 2. Redis 7.4 (Token Denylists, Rate Limits & Distributed Locks)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password-min-24-chars

# -----------------------------------------------------------------------------
# 3. MinIO S3 Object Storage (Documents, Payslips & Attachments)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=hrminio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password-min-16-chars

# -----------------------------------------------------------------------------
# 4. Cryptographic Secrets (Field Encryption & JWT Signing)
# -----------------------------------------------------------------------------
# Field Encryption Key: AES-256 (32 bytes base64 encoded)
# Generate with:
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-aes-key

# JWT RSA Key Pair: 2048-bit PKCS#8 Private Key & X.509 Public Key in Base64 (single-line)
# Generate with OpenSSL:
#   1. Generate private PEM:
#        openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   2. Extract single-line Base64 PKCS#8 DER:
#        openssl pkcs8 -topk8 -inform PEM -outform DER -in jwt_private.pem -nocrypt | base64 | tr -d '\r\n'
#   3. Extract single-line Base64 X.509 DER public key:
#        openssl rsa -in jwt_private.pem -pubout -outform DER | base64 | tr -d '\r\n'
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-rsa-private-key
JWT_PUBLIC_KEY=replace-with-base64-x509-rsa-public-key

# -----------------------------------------------------------------------------
# 5. Network & Gateway Configuration
# -----------------------------------------------------------------------------
# Public HTTP binding port for Nginx edge reverse-proxy
HTTP_PORT=80
