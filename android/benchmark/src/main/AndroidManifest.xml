<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Macrobenchmark drives the app from a separate process, so it needs to see
      and launch another package. On API 30+ package visibility is restricted
      by default and the benchmark fails with a confusing "package not found".
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
